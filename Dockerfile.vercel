FROM node:22-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY vite.config.js tailwind.config.js postcss.config.js ./
COPY resources ./resources
COPY public ./public
RUN npm run build

FROM dunglas/frankenphp:1-php8.4-alpine AS php-base
WORKDIR /app
RUN install-php-extensions pdo_pgsql pdo_mysql mbstring intl zip bcmath opcache \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

FROM php-base AS dependencies
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress
COPY app ./app
COPY database ./database
RUN composer dump-autoload --no-dev --optimize --no-scripts

FROM php-base AS runtime
ENV APP_ENV=production APP_DEBUG=false PORT=80 \
    LOG_CHANNEL=stderr SESSION_DRIVER=database CACHE_STORE=database QUEUE_CONNECTION=sync
COPY --from=dependencies /app/vendor ./vendor
COPY artisan composer.json composer.lock ./
COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY lang ./lang
COPY database/migrations ./database/migrations
COPY database/seeders ./database/seeders
COPY resources/views ./resources/views
COPY routes ./routes
COPY public ./public
COPY --from=frontend /app/public/build ./public/build
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY deploy/php.ini /usr/local/etc/php/conf.d/escopo.ini
COPY deploy/start.sh /usr/local/bin/escopo-start
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && rm -f public/hot bootstrap/cache/config.php bootstrap/cache/routes-*.php bootstrap/cache/packages.php bootstrap/cache/services.php \
    && chmod +x /usr/local/bin/escopo-start \
    && chown -R www-data:www-data /app /config /data
USER www-data
EXPOSE 8080
ENV PORT=8080
CMD ["sh", "/usr/local/bin/escopo-start"]
