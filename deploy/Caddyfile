{
    admin off
    auto_https off
    persist_config off
}

:{$PORT:8080} {
    root * /app/public
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    @private path /.env* /.git/* /vendor/* /storage/* /composer.* /artisan
    respond @private 404
    php_server
}
