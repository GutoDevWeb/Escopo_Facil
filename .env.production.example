# Modelo SEM credenciais. Copie para .env APENAS no servidor e preencha os valores.
APP_NAME="Escopo Fácil"
APP_ENV=production
# production descreve a hospedagem; o projeto continua acadêmico, sem cobranças reais.
APP_KEY=
APP_DEBUG=false
APP_URL=https://SEU-DOMINIO.example
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# Banco EXTERNO persistente. Use a conexão fornecida pelo provedor.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_PATH=/
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
PORT=8080
TRUST_PLATFORM_PROXY=true
# Gere com: php -r "echo bin2hex(random_bytes(32));"
CRON_SECRET=

# Gmail exclusivo do projeto. MAIL_PASSWORD recebe uma senha de aplicativo
# desta mesma conta Google, com verificação em duas etapas ativada.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=escopofacil@gmail.com
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=escopofacil@gmail.com
MAIL_FROM_NAME="Escopo Fácil"
# Opcional: preencher somente com um endereço que realmente receba respostas.
MAIL_REPLY_TO_ADDRESS=escopofacil@gmail.com
SUPPORT_EMAIL=escopofacil@gmail.com
# Caixa existente para receber o formulário; pode ser diferente do domínio remetente.
# Sem destino, o formulário retorna indisponibilidade e não tenta enviar.
CONTACT_MAIL_TO=escopofacil@gmail.com
SUPPORT_WHATSAPP_URL=
SUPPORT_WHATSAPP_LABEL="WhatsApp do suporte"

# Manter os responsáveis corretos nos documentos; o contato público usa SUPPORT_EMAIL.
LEGAL_RESPONSIBLE="Guilherme Augusto Tavares Cavalcante, Nicollas Ferreira e Natan Gomes"
LEGAL_INSTITUTION="Centro Universitário Senac — Tecnologia em Sistemas para Internet"
LEGAL_VERSION=2026-10-22
LEGAL_RETENTION_END=

# Demo online: PIX_DEMO_ENABLED=true com chave dev_ privada.
PIX_DRIVER=abacate
PIX_DEMO_ENABLED=false
ABACATEPAY_DEV_KEY=
VITE_APP_NAME="${APP_NAME}"
